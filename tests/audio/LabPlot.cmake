foreach(step "plot;${WAV};${OUT}/native" "plot;${WATSON};${OUT}/watson" "plot-diff;${WAV};${WATSON};${OUT}/native-minus-watson")
    execute_process(COMMAND ${LAB} ${step} RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "SoundLab ${step} failed with ${code}")
    endif()
endforeach()
foreach(png native-wave native-spectrum watson-wave watson-spectrum native-minus-watson-diff)
    if(NOT EXISTS ${OUT}/${png}.png)
        message(FATAL_ERROR "missing plot ${OUT}/${png}.png")
    endif()
endforeach()
