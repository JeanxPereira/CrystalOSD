execute_process(COMMAND ${NINJA} -f build-${CONFIG}.ninja -t deps WORKING_DIRECTORY ${BUILD_DIR} OUTPUT_VARIABLE deps RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "ninja -t deps failed (${status})")
endif()
string(REGEX MATCHALL "[^\n]*Source/Scene/[^\n]*\.obj: #deps [0-9]+" lines "${deps}")
if(NOT lines)
    message(FATAL_ERROR "no scene object has recorded dependencies: build the tests first")
endif()
set(blind "")
foreach(line IN LISTS lines)
    if(line MATCHES "#deps 0$")
        list(APPEND blind "${line}")
    endif()
endforeach()
if(blind)
    message(FATAL_ERROR "Ninja records no header dependencies (localized compiler output? set VSLANG=1033 and reconfigure):\n${blind}")
endif()
